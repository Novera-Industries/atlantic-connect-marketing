# Copy to .env and adjust, then run ./deploy.sh
#
#   cp .env.example .env

# Public hostname (Caddy site block + canonical origin).
DOMAIN=acm.vyradata.com

# Canonical origin baked into the build (metadata, sitemap, robots, JSON-LD).
# Almost always https://<DOMAIN>.
NEXT_PUBLIC_SITE_URL=https://acm.vyradata.com

# Loopback port the container publishes; Caddy reverse-proxies to it.
# Must be free on the host. In-use on this VPS: 3000 3100 4000 4100 5003 5101
# 5102 8083 8095 8096 8097 8098 8100. 8101 is free.
APP_PORT=8101

# Compose project namespace (groups containers/volumes; matches the box's style).
COMPOSE_PROJECT_NAME=acm-marketing

# Path to the server's Caddyfile (deploy.sh wires the site block here).
CADDYFILE=/etc/caddy/Caddyfile
